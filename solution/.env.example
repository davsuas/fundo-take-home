# Local defaults. `make up` copies this to .env if .env does not exist. Never commit .env.

# Postgres: a superuser for bootstrap, a schema owner used only by `migrate`,
# and a least-privilege role (no DDL) used by api and worker at runtime.
POSTGRES_DB=fundo_loans
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
POSTGRES_MIGRATOR_USER=loans_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator-password
POSTGRES_APP_USER=loans_app
POSTGRES_APP_PASSWORD=change-me-app-password

# Secret key for the SSN HMAC. The app refuses to start without it.
SSN_HASH_PEPPER=change-me-to-a-long-random-string

# Host ports
FRONTEND_PORT=5330
API_PORT=5130
EXTERNAL_SERVICE_PORT=5230
